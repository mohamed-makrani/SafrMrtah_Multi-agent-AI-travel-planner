# Copy this file to .env and fill in your own values.
# Never commit .env - it is ignored by git and by Docker builds.

# --- Required ---
GROQ_API_KEY=
DATABASE_URL=
TAVILY_API_KEY=
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=

# --- Sign-in (strongly recommended on any public server) ---
APP_USERNAME=admin
APP_PASSWORD=

# --- Optional: separate weather MCP server ---
# Without these, the app starts the weather server itself.
# WEATHER_MCP_URL=http://127.0.0.1:8001/mcp
# WEATHER_MCP_TOKEN=

# --- Optional: LangSmith tracing ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
